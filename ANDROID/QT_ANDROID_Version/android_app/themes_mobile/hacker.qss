/* ── Tema: hacker — accento #39ff14 matrix green, sfondo quasi-nero verde ── */

QMainWindow, QWidget { background-color: #080f00; }
QDialog               { background-color: #080f00; }
QMessageBox           { background-color: #080f00; }

QWidget#HeaderBar { background-color: #040800; border-bottom: 1px solid #1a2400; }
QWidget#NavDrawer { background-color: #040800; border-right:  1px solid #1a2400; }
QGroupBox#SettingsGroup::title { background-color: #080f00; color: #39ff14; }

QLineEdit { selection-background-color: #39ff14; }
QLineEdit:focus { border-color: #39ff14; background-color: #121900; }
QSpinBox:focus  { border-color: #39ff14; }
QDoubleSpinBox:focus { border-color: #39ff14; }
QComboBox:focus { border-color: #39ff14; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #39ff14; }
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background-color: #39ff14; }
QLineEdit#SettingsInput:focus,
QSpinBox#SettingsInput:focus,
QComboBox#SettingsInput:focus { border-color: #39ff14; }
QLineEdit#ChatInput { selection-background-color: #39ff14; }
QLineEdit#ChatInput:focus { border-color: #39ff14; background-color: #121900; }

QCheckBox::indicator:checked { background-color: #39ff14; border-color: #39ff14; }
QCheckBox::indicator:hover   { border-color: #39ff14; }

QDialogButtonBox QPushButton:hover   { border-color: #39ff14; }
QDialogButtonBox QPushButton:default { background-color: #39ff14; border-color: #39ff14; color: #000000; }
QDialogButtonBox QPushButton:default:hover { background-color: #5dff42; }

QFrame#AiBubble   { background-color: #061200; border: 1px solid rgba(57,255,20,0.28); }
QFrame#UserBubble { background-color: #0e1e00; border: 1px solid rgba(57,255,20,0.45); }
QPushButton#BubbleActionBtn { background-color: #091600; border: 1px solid rgba(57,255,20,0.25); }
QPushButton#BubbleActionBtn:hover   { background-color: #102000; border-color: #39ff14; }
QPushButton#BubbleActionBtn:pressed { background-color: #39ff14; }

QPushButton#PrimaryBtn         { background-color: #39ff14; color: #000000; }
QPushButton#PrimaryBtn:hover   { background-color: #5dff42; }
QPushButton#PrimaryBtn:pressed { background-color: #2ecc10; }
QPushButton#SecondaryBtn { color: #39ff14; border: 1px solid #39ff14; }
QPushButton#SecondaryBtn:hover   { background-color: rgba(57,255,20,0.12); }
QPushButton#SecondaryBtn:pressed { background-color: rgba(57,255,20,0.20); }
QPushButton#SendBtn         { background-color: #39ff14; }
QPushButton#SendBtn:hover   { background-color: #5dff42; }
QPushButton#SendBtn:pressed { background-color: #2ecc10; }

QPushButton#BackendCloudBtn:checked,
QPushButton#BackendServerBtn:checked { background-color: #39ff14; border-color: #39ff14; color: #000000; }
QLabel#BackendStatusLbl[backend="server"] {
    background-color: rgba(57,255,20,0.12);
    color: #39ff14;
    border: 1px solid rgba(57,255,20,0.30);
}

QSlider#TempSlider::handle:horizontal { background-color: #39ff14; border: 2px solid #080f00; }
QSlider#TempSlider::sub-page:horizontal { background-color: #39ff14; }
QListWidget#BleList::item:selected { background-color: rgba(57,255,20,0.15); }
