/* ── Tema: neon — accento #00ff9d, sfondo nero profondo ── */

QMainWindow, QWidget { background-color: #0a0a0a; }
QDialog               { background-color: #0a0a0a; }
QMessageBox           { background-color: #0a0a0a; }

QWidget#HeaderBar { background-color: #050505; border-bottom: 1px solid #181818; }
QWidget#NavDrawer { background-color: #050505; border-right:  1px solid #181818; }
QGroupBox#SettingsGroup::title { background-color: #0a0a0a; color: #00ff9d; }

QLineEdit { selection-background-color: #00ff9d; }
QLineEdit:focus { border-color: #00ff9d; background-color: #171717; }
QSpinBox:focus  { border-color: #00ff9d; }
QDoubleSpinBox:focus { border-color: #00ff9d; }
QComboBox:focus { border-color: #00ff9d; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #00ff9d; }
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background-color: #00ff9d; }
QLineEdit#SettingsInput:focus,
QSpinBox#SettingsInput:focus,
QComboBox#SettingsInput:focus { border-color: #00ff9d; }
QLineEdit#ChatInput { selection-background-color: #00ff9d; }
QLineEdit#ChatInput:focus { border-color: #00ff9d; background-color: #171717; }

QCheckBox::indicator:checked { background-color: #00ff9d; border-color: #00ff9d; }
QCheckBox::indicator:hover   { border-color: #00ff9d; }

QDialogButtonBox QPushButton:hover   { border-color: #00ff9d; }
QDialogButtonBox QPushButton:default { background-color: #00ff9d; border-color: #00ff9d; color: #000000; }
QDialogButtonBox QPushButton:default:hover { background-color: #33ffb3; }

QFrame#AiBubble   { background-color: #041a0e; border: 1px solid rgba(0,255,157,0.28); }
QFrame#UserBubble { background-color: #072a18; border: 1px solid rgba(0,255,157,0.45); }
QPushButton#BubbleActionBtn { background-color: #051510; border: 1px solid rgba(0,255,157,0.25); }
QPushButton#BubbleActionBtn:hover   { background-color: #0a2018; border-color: #00ff9d; }
QPushButton#BubbleActionBtn:pressed { background-color: #00ff9d; }

QPushButton#PrimaryBtn         { background-color: #00ff9d; color: #000000; }
QPushButton#PrimaryBtn:hover   { background-color: #33ffb3; }
QPushButton#PrimaryBtn:pressed { background-color: #00cc7d; }
QPushButton#SecondaryBtn { color: #00ff9d; border: 1px solid #00ff9d; }
QPushButton#SecondaryBtn:hover   { background-color: rgba(0,255,157,0.12); }
QPushButton#SecondaryBtn:pressed { background-color: rgba(0,255,157,0.20); }
QPushButton#SendBtn         { background-color: #00ff9d; }
QPushButton#SendBtn:hover   { background-color: #33ffb3; }
QPushButton#SendBtn:pressed { background-color: #00cc7d; }

QPushButton#BackendCloudBtn:checked,
QPushButton#BackendServerBtn:checked { background-color: #00ff9d; border-color: #00ff9d; color: #000000; }
QLabel#BackendStatusLbl[backend="server"] {
    background-color: rgba(0,255,157,0.12);
    color: #00ff9d;
    border: 1px solid rgba(0,255,157,0.30);
}

QSlider#TempSlider::handle:horizontal { background-color: #00ff9d; border: 2px solid #0a0a0a; }
QSlider#TempSlider::sub-page:horizontal { background-color: #00ff9d; }
QListWidget#BleList::item:selected { background-color: rgba(0,255,157,0.15); }
