/* ── Tema: dark_purple — accento #8b5cf6, sfondo viola scuro ── */

QMainWindow, QWidget { background-color: #13111f; }
QDialog               { background-color: #13111f; }
QMessageBox           { background-color: #13111f; }

QWidget#HeaderBar { background-color: #0d0b17; border-bottom: 1px solid #24203a; }
QWidget#NavDrawer { background-color: #0d0b17; border-right:  1px solid #24203a; }
QGroupBox#SettingsGroup::title { background-color: #13111f; color: #8b5cf6; }

QLineEdit { selection-background-color: #8b5cf6; }
QLineEdit:focus { border-color: #8b5cf6; background-color: #1e1c2e; }
QSpinBox:focus  { border-color: #8b5cf6; }
QDoubleSpinBox:focus { border-color: #8b5cf6; }
QComboBox:focus { border-color: #8b5cf6; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #8b5cf6; }
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background-color: #8b5cf6; }
QLineEdit#SettingsInput:focus,
QSpinBox#SettingsInput:focus,
QComboBox#SettingsInput:focus { border-color: #8b5cf6; }
QLineEdit#ChatInput { selection-background-color: #8b5cf6; }
QLineEdit#ChatInput:focus { border-color: #8b5cf6; background-color: #1e1c2e; }

QCheckBox::indicator:checked { background-color: #8b5cf6; border-color: #8b5cf6; }
QCheckBox::indicator:hover   { border-color: #8b5cf6; }

QDialogButtonBox QPushButton:hover   { border-color: #8b5cf6; }
QDialogButtonBox QPushButton:default { background-color: #8b5cf6; border-color: #8b5cf6; }
QDialogButtonBox QPushButton:default:hover { background-color: #a78bfa; }

QFrame#AiBubble   { background-color: #0e0c1e; border: 1px solid rgba(139,92,246,0.28); }
QFrame#UserBubble { background-color: #160f30; border: 1px solid rgba(139,92,246,0.45); }
QPushButton#BubbleActionBtn { background-color: #120e26; border: 1px solid rgba(139,92,246,0.25); }
QPushButton#BubbleActionBtn:hover   { background-color: #1c1638; border-color: #8b5cf6; }
QPushButton#BubbleActionBtn:pressed { background-color: #8b5cf6; }

QPushButton#PrimaryBtn         { background-color: #8b5cf6; }
QPushButton#PrimaryBtn:hover   { background-color: #a78bfa; }
QPushButton#PrimaryBtn:pressed { background-color: #7c3aed; }
QPushButton#SecondaryBtn { color: #8b5cf6; border: 1px solid #8b5cf6; }
QPushButton#SecondaryBtn:hover   { background-color: rgba(139,92,246,0.12); }
QPushButton#SecondaryBtn:pressed { background-color: rgba(139,92,246,0.20); }
QPushButton#SendBtn         { background-color: #8b5cf6; }
QPushButton#SendBtn:hover   { background-color: #a78bfa; }
QPushButton#SendBtn:pressed { background-color: #7c3aed; }

QPushButton#BackendCloudBtn:checked,
QPushButton#BackendServerBtn:checked { background-color: #8b5cf6; border-color: #8b5cf6; }
QLabel#BackendStatusLbl[backend="server"] {
    background-color: rgba(139,92,246,0.12);
    color: #8b5cf6;
    border: 1px solid rgba(139,92,246,0.30);
}

QSlider#TempSlider::handle:horizontal { background-color: #8b5cf6; border: 2px solid #13111f; }
QSlider#TempSlider::sub-page:horizontal { background-color: #8b5cf6; }
QListWidget#BleList::item:selected { background-color: rgba(139,92,246,0.15); }
