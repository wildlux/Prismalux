/* ── Tema: dark_amber — accento #f59e0b ambra/oro, sfondo caldo scuro ── */

QMainWindow, QWidget { background-color: #1a1400; }
QDialog               { background-color: #1a1400; }
QMessageBox           { background-color: #1a1400; }

QWidget#HeaderBar { background-color: #110e00; border-bottom: 1px solid #2e2200; }
QWidget#NavDrawer { background-color: #110e00; border-right:  1px solid #2e2200; }
QGroupBox#SettingsGroup::title { background-color: #1a1400; color: #f59e0b; }

QLineEdit { selection-background-color: #f59e0b; }
QLineEdit:focus { border-color: #f59e0b; background-color: #261e00; }
QSpinBox:focus  { border-color: #f59e0b; }
QDoubleSpinBox:focus { border-color: #f59e0b; }
QComboBox:focus { border-color: #f59e0b; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #f59e0b; }
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background-color: #f59e0b; }
QLineEdit#SettingsInput:focus,
QSpinBox#SettingsInput:focus,
QComboBox#SettingsInput:focus { border-color: #f59e0b; }
QLineEdit#ChatInput { selection-background-color: #f59e0b; }
QLineEdit#ChatInput:focus { border-color: #f59e0b; background-color: #261e00; }

QCheckBox::indicator:checked { background-color: #f59e0b; border-color: #f59e0b; }
QCheckBox::indicator:hover   { border-color: #f59e0b; }

QDialogButtonBox QPushButton:hover   { border-color: #f59e0b; }
QDialogButtonBox QPushButton:default { background-color: #f59e0b; border-color: #f59e0b; color: #000000; }
QDialogButtonBox QPushButton:default:hover { background-color: #fbbf24; }

QFrame#AiBubble   { background-color: #1a1000; border: 1px solid rgba(245,158,11,0.28); }
QFrame#UserBubble { background-color: #2a1a00; border: 1px solid rgba(245,158,11,0.45); }
QPushButton#BubbleActionBtn { background-color: #201400; border: 1px solid rgba(245,158,11,0.25); }
QPushButton#BubbleActionBtn:hover   { background-color: #301e00; border-color: #f59e0b; }
QPushButton#BubbleActionBtn:pressed { background-color: #f59e0b; }

QPushButton#PrimaryBtn         { background-color: #f59e0b; color: #000000; }
QPushButton#PrimaryBtn:hover   { background-color: #fbbf24; }
QPushButton#PrimaryBtn:pressed { background-color: #d97706; }
QPushButton#SecondaryBtn { color: #f59e0b; border: 1px solid #f59e0b; }
QPushButton#SecondaryBtn:hover   { background-color: rgba(245,158,11,0.12); }
QPushButton#SecondaryBtn:pressed { background-color: rgba(245,158,11,0.20); }
QPushButton#SendBtn         { background-color: #f59e0b; }
QPushButton#SendBtn:hover   { background-color: #fbbf24; }
QPushButton#SendBtn:pressed { background-color: #d97706; }

QPushButton#BackendCloudBtn:checked,
QPushButton#BackendServerBtn:checked { background-color: #f59e0b; border-color: #f59e0b; color: #000000; }
QLabel#BackendStatusLbl[backend="server"] {
    background-color: rgba(245,158,11,0.12);
    color: #f59e0b;
    border: 1px solid rgba(245,158,11,0.30);
}

QSlider#TempSlider::handle:horizontal { background-color: #f59e0b; border: 2px solid #1a1400; }
QSlider#TempSlider::sub-page:horizontal { background-color: #f59e0b; }
QListWidget#BleList::item:selected { background-color: rgba(245,158,11,0.15); }
