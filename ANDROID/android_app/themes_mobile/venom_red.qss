/* ── Tema: venom_red — accento #ef4444, sfondo rosso scuro ── */

QMainWindow, QWidget { background-color: #1a0a0a; }
QDialog               { background-color: #1a0a0a; }
QMessageBox           { background-color: #1a0a0a; }

QWidget#HeaderBar { background-color: #110505; border-bottom: 1px solid #2e1818; }
QWidget#NavDrawer { background-color: #110505; border-right:  1px solid #2e1818; }
QGroupBox#SettingsGroup::title { background-color: #1a0a0a; color: #ef4444; }

QLineEdit { selection-background-color: #ef4444; }
QLineEdit:focus { border-color: #ef4444; background-color: #251010; }
QSpinBox:focus  { border-color: #ef4444; }
QDoubleSpinBox:focus { border-color: #ef4444; }
QComboBox:focus { border-color: #ef4444; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #ef4444; }
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background-color: #ef4444; }
QLineEdit#SettingsInput:focus,
QSpinBox#SettingsInput:focus,
QComboBox#SettingsInput:focus { border-color: #ef4444; }
QLineEdit#ChatInput { selection-background-color: #ef4444; }
QLineEdit#ChatInput:focus { border-color: #ef4444; background-color: #251010; }

QCheckBox::indicator:checked { background-color: #ef4444; border-color: #ef4444; }
QCheckBox::indicator:hover   { border-color: #ef4444; }

QDialogButtonBox QPushButton:hover   { border-color: #ef4444; }
QDialogButtonBox QPushButton:default { background-color: #ef4444; border-color: #ef4444; }
QDialogButtonBox QPushButton:default:hover { background-color: #f87171; }

QFrame#AiBubble   { background-color: #1a0606; border: 1px solid rgba(239,68,68,0.28); }
QFrame#UserBubble { background-color: #2e0e0e; border: 1px solid rgba(239,68,68,0.45); }
QPushButton#BubbleActionBtn { background-color: #200808; border: 1px solid rgba(239,68,68,0.25); }
QPushButton#BubbleActionBtn:hover   { background-color: #310e0e; border-color: #ef4444; }
QPushButton#BubbleActionBtn:pressed { background-color: #ef4444; }

QPushButton#PrimaryBtn         { background-color: #ef4444; }
QPushButton#PrimaryBtn:hover   { background-color: #f87171; }
QPushButton#PrimaryBtn:pressed { background-color: #dc2626; }
QPushButton#SecondaryBtn { color: #ef4444; border: 1px solid #ef4444; }
QPushButton#SecondaryBtn:hover   { background-color: rgba(239,68,68,0.12); }
QPushButton#SecondaryBtn:pressed { background-color: rgba(239,68,68,0.20); }
QPushButton#SendBtn         { background-color: #ef4444; }
QPushButton#SendBtn:hover   { background-color: #f87171; }
QPushButton#SendBtn:pressed { background-color: #dc2626; }

QPushButton#BackendCloudBtn:checked,
QPushButton#BackendServerBtn:checked { background-color: #ef4444; border-color: #ef4444; }
QLabel#BackendStatusLbl[backend="server"] {
    background-color: rgba(239,68,68,0.12);
    color: #ef4444;
    border: 1px solid rgba(239,68,68,0.30);
}

QSlider#TempSlider::handle:horizontal { background-color: #ef4444; border: 2px solid #1a0a0a; }
QSlider#TempSlider::sub-page:horizontal { background-color: #ef4444; }
QListWidget#BleList::item:selected { background-color: rgba(239,68,68,0.15); }
