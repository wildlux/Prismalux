<?xml version="1.0" encoding="utf-8"?>
<!-- Permette HTTP cleartext verso reti locali (LAN Prismalux) -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- IPv4 LAN tipiche -->
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
    </domain-config>
    <!-- Permette cleartext per qualsiasi IP privato via usesCleartextTraffic -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
