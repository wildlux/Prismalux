/* ══════════════════════════════════════════════════════════════
   Prismalux — Tema Dracula
   Palette allineata alla webchat LAN: bg #282a36 | hdr #21222c | accent #bd93f9 | txt #f8f8f2
   ══════════════════════════════════════════════════════════════ */

* {
    font-family: "Segoe UI","Cantarell","Ubuntu","Helvetica Neue",sans-serif;
    font-size: 13px; color: #f8f8f2; outline: none;
}
QMainWindow, QWidget { background-color: #21222c; }

QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: #282a36; width: 6px; margin: 0; }
QScrollBar::handle:vertical { background: #44475a; min-height: 24px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: #bd93f9; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

#header {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #282a36, stop:1 #21222c);
    border-bottom: 1px solid #bd93f9; min-height: 52px;
}
#headerTitle { font-size: 17px; font-weight: 700; color: #cba6ff; letter-spacing: 4px; }
#headerSub { font-size: 11px; color: #44475a; }
#headerBeer { font-size: 22px; }

#sidebar { background: #191a21; border-right: 1px solid #282a36; min-width: 210px; max-width: 210px; }

QPushButton#navBtn { background: transparent; border: none; border-left: 3px solid transparent; color: #4a3b52; text-align: left; padding: 0; }
QPushButton#navBtn:hover { background: #21222c; border-left-color: #44475a; color: #bd93f9; }
QPushButton#navBtn[active="true"] { background: #282a36; border-left-color: #bd93f9; }
QPushButton#navBtn[active="true"] QLabel#cardTitle { color: #cba6ff; }
QPushButton#navBtn[active="true"] QLabel#cardDesc  { color: #7a6a9a; }
QPushButton#navBtn:hover QLabel#cardTitle { color: #d8d0f0; }
QPushButton#navBtn QLabel#cardDesc { color: #6272a4; }
QPushButton#navBtn:hover QLabel#cardDesc { color: #a99ad0; }

#contentArea { background: #21222c; }

QFrame#actionCard { background: #282a36; border: 1px solid #343746; border-radius: 8px; }
QFrame#actionCard:hover { background: #343746; border-color: #bd93f9; }

#cardIcon { font-size: 22px; padding: 0; }
#cardTitle { font-size: 14px; font-weight: 600; color: #e8e8f0; }
#cardDesc  { font-size: 11px; color: #4f4258; }
#pageTitle { font-size: 22px; font-weight: 700; color: #cba6ff; padding-bottom: 2px; }
#pageSubtitle { font-size: 12px; color: #4f4258; }
#pageDivider { background: #282a36; max-height: 1px; min-height: 1px; }
QLabel { background: transparent; }

#gaugeLabel { font-size: 10px; font-weight: 700; color: #4f4258; min-width: 32px; }
#gaugePct   { font-size: 10px; color: #6272a4; min-width: 38px; }
QProgressBar#resBar { background: #191a21; border: none; border-radius: 3px; }
QProgressBar#resBar::chunk { background: #50fa7b; border-radius: 3px; }
QProgressBar#resBar[level="warn"]::chunk { background: #f1fa8c; }
QProgressBar#resBar[level="crit"]::chunk { background: #f44336; }

QTextEdit#chatLog {
    background: #191a21; border: 1px solid #282a36; border-radius: 6px;
    color: #e8e8f0; padding: 10px;
    font-family: "Consolas","JetBrains Mono","Courier New",monospace; font-size: 13px;
    selection-background-color: #4a3a5e;
}
QTextEdit#chatInput { background: #282a36; border: 1px solid #343746; border-radius: 6px; color: #f8f8f2; padding: 8px 12px; }
QTextEdit#chatInput:focus { border-color: #bd93f9; }

QPushButton#actionBtn { background: #a77bf0; border: none; border-radius: 6px; color: #282a36; font-weight: 700; padding: 7px 18px; min-width: 72px; }
QPushButton#actionBtn:hover   { background: #bd93f9; }
QPushButton#actionBtn:pressed { background: #9a6ee0; }
QPushButton#actionBtn:disabled{ background: #282a36; color: #4a3b52; }
QPushButton#actionBtn[danger="true"] { background: #c62828; color: #fff; }
QPushButton#actionBtn[danger="true"]:hover { background: #e53935; }

QComboBox { background: #282a36; border: 1px solid #343746; border-radius: 6px; padding: 5px 10px; color: #e8e8f0; }
QComboBox:hover { border-color: #bd93f9; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { background: #282a36; border: 1px solid #bd93f9; selection-background-color: #343746; color: #e8e8f0; outline: none; }

QGroupBox { border: 1px solid #343746; border-radius: 6px; margin-top: 14px; color: #4f4258; font-size: 11px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }

QStatusBar { background: #191a21; border-top: 1px solid #282a36; color: #4a3b52; font-size: 11px; }

QPushButton#themeBtn { background: transparent; border: 1px solid #343746; border-radius: 16px; color: #6272a4; font-size: 13px; padding: 4px 10px; min-width: 32px; }
QPushButton#themeBtn:hover { border-color: #bd93f9; color: #cba6ff; background: #282a36; }
QPushButton#themeBtn[active="true"] { border-color: #bd93f9; color: #cba6ff; background: #313342; }

QPushButton#emergencyBtn { background: transparent; border: none; border-radius: 6px; font-size: 18px; padding: 2px; }
QPushButton#emergencyBtn:hover   { background: rgba(183,28,28,0.18); }
QPushButton#emergencyBtn:pressed { background: rgba(183,28,28,0.32); }
QPushButton#emergencyBtn:disabled{ background: transparent; opacity: 0.4; }

#footerHints { font-size:11px; color:#4a3b52; background:#191a21; padding:2px 6px; }

/* ── QListWidget (Cerca Lavoro offerte) ── */
QListWidget, QListView {
    background: #21222c;
    color: #f8f8f2;
    border: 1px solid #282a36;
    border-radius: 6px;
    outline: none;
}
QListWidget::item, QListView::item {
    color: #f8f8f2;
    background: transparent;
    border-bottom: 1px solid #282a36;
    padding: 6px 8px;
}
QListWidget::item:alternate, QListView::item:alternate {
    background: #282a36;
    color: #f8f8f2;
}
QListWidget::item:selected, QListView::item:selected {
    background: #3d2f4d;
    color: #bd93f9;
    border-left: 3px solid #bd93f9;
}
QListWidget::item:hover:!selected, QListView::item:hover:!selected {
    background: #2c2e3b;
    color: #f8f8f2;
}

/* ── Label sottotitolo pagine ── */
QLabel#pageSubtitle { color: #f8f8f2; opacity: 0.7; font-size: 11px; }

/* ── QLineEdit generico (widget senza objectName) ── */
QLineEdit {
    background: #282a36; color: #f8f8f2;
    border: 1px solid #343746; border-radius: 6px; padding: 5px 10px;
    selection-background-color: rgba(255,255,255,0.12);
}
QLineEdit:focus    { border-color: #bd93f9; }
QLineEdit:disabled { opacity: 0.45; }

/* ── QTextEdit generico ── */
QTextEdit {
    background: #282a36; color: #f8f8f2;
    border: 1px solid #343746; border-radius: 6px; padding: 6px;
    selection-background-color: rgba(255,255,255,0.12);
}
QTextEdit:focus { border-color: #bd93f9; }

/* ── Output AI readonly (objectName="outputView") ── */
QTextEdit#outputView {
    background: #232530; color: #f8f8f2;
    border: 1px solid #343746; border-radius: 6px;
    font-family: "JetBrains Mono","Consolas","Courier New",monospace;
    font-size: 12px;
}

/* ── Hint label (objectName="hintLabel") ── */
QLabel#hintLabel { color: #f8f8f2; opacity: 0.65; background: transparent; font-size: 12px; }

/* strActBtn/strCatBtn/ragRow */
/* ── Strumenti AI — catBtn / actBtn / ragRow (auto-generato dal tema) ── */
QPushButton#strCatBtn {
    border: none; border-bottom: 2px solid transparent;
    padding: 4px 8px; background: transparent;
    color: #6272a4; font-size: 12px; font-weight: bold; }
QPushButton#strCatBtn:checked {
    border-bottom: 2px solid #bd93f9; color: #f8f8f2; }
QPushButton#strCatBtn:hover { color: #b0b0c0; }

QPushButton#strActBtn {
    border: 1px solid #44475a; border-radius: 8px;
    padding: 8px 10px; background: #282a36;
    color: #6272a4; font-size: 12px; text-align: left; }
QPushButton#strActBtn:checked {
    background: #44475a; border-color: #bd93f9;
    color: #f8f8f2; font-weight: bold; }
QPushButton#strActBtn:hover { background: #21222c; color: #f8f8f2; }

QWidget#ragRow {
    background: #21222c; border: 1px solid #44475a; border-radius: 6px; }

/* ── Chat Bubbles — override tema Dark Purple ── */
QFrame#bubbleAI   { background-color: #282a36; border: 1px solid rgba(189,147,249,0.28); }
QFrame#bubbleUser { background-color: #3f2a44; border: 1px solid rgba(189,147,249,0.45); }
#bubbleSenderAI   { color: #ff79c6; }
#bubbleSenderUser { color: #ff92d0; }
QTextBrowser#bubbleText { color: #f8f8f2; }
QPushButton#bubbleBtn   { background-color: #282a36; color: #6272a4; border: 1px solid rgba(189,147,249,0.25); }
QPushButton#bubbleBtn:hover { background-color: #44475a; border-color: #bd93f9; color: #f8f8f2; }
#chatScroll { background-color: #191a21; }
