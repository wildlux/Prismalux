/* ══════════════════════════════════════════════════════════════
   base.qss — Regole strutturali iniettate DOPO ogni tema.
   Contiene SOLO regole di struttura (dimensioni, track), ZERO colori.
   I colori vengono dal tema; queste regole vincono su width e add/sub-page.
   ══════════════════════════════════════════════════════════════ */

/* ── Scrollbar verticale: 8px (più cliccabile su Windows) ── */
QScrollBar:vertical          { width: 8px; margin: 0; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }

/* ── Scrollbar orizzontale ── */
QScrollBar:horizontal          { height: 8px; margin: 0; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: transparent; }
/* handle neutro — applicato dopo ogni tema; i temi non ridefiniscono questo selettore */
QScrollBar::handle:horizontal {
    background: rgba(128,128,128,0.35);
    min-width: 30px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(128,128,128,0.65);
}

/* ── ScrollArea trasparente ── */
QScrollArea { background: transparent; border: none; }

/* ── Separatori QFrame — rimuove la linea bianca di default Qt ── */
QFrame#sidebarSep { max-height: 1px; border: none; }
QFrame#navMenuSep { max-width:  1px; border: none; }

/* ── Pulsanti header — rimuove highlight bianca in cima (Fusion/Breeze) ── */
#header QPushButton { border-top: none; }

/* ── Separatore card ── */
QFrame#cardSep { max-height: 1px; border: none; border-top: 1px solid rgba(255,255,255,0.08); }

/* ── Item lista test — bordo strutturale (colori via setStyleSheet dinamico) ── */
QFrame#testListItem { border-radius: 6px; padding: 2px; }

/* ── Pulsanti toggle Think Mode (thinkMode Off/Auto/On) ── */
QPushButton#thinkModeBtn {
    background-color: transparent;
    border: 1px solid rgba(128,128,128,0.35);
    border-radius: 5px;
    color: rgba(128,128,128,0.85);
    font-weight: 600; font-size: 12px;
    padding: 4px 10px; min-width: 38px;
}
QPushButton#thinkModeBtn:hover {
    background-color: rgba(128,128,128,0.12);
    border-color: rgba(128,128,128,0.6);
    color: palette(text);
}
QPushButton#thinkModeBtn:checked {
    background-color: #0ea5e9;
    border-color: #0ea5e9;
    color: #ffffff;
}
QPushButton#thinkModeBtn:disabled {
    color: rgba(128,128,128,0.25);
    border-color: rgba(128,128,128,0.12);
}

/* ── Barra Ingrandimento (status bar basso destra) ── */
QWidget#zoomBar {
    background: transparent;
}
QLabel#zoomBarLabel {
    font-size: 11px;
    color: palette(mid);
    min-width: 38px;
}
QPushButton#zoomBtn {
    background: transparent;
    border: 1px solid palette(mid);
    border-radius: 3px;
    color: palette(buttontext);
    font-size: 15px;
    font-weight: bold;
    padding: 0;
}
QPushButton#zoomBtn:hover {
    border-color: #4c9be8;
    color: #4c9be8;
    background: rgba(76,155,232,0.10);
}
QPushButton#zoomBtn:pressed {
    background: rgba(76,155,232,0.22);
}
QPushButton#zoomBtn:disabled {
    border-color: rgba(128,128,128,0.30);
    color: rgba(128,128,128,0.40);
}
QPushButton#zoomResetBtn {
    background: transparent;
    border: none;
    color: palette(mid);
    font-size: 9px;
    padding: 0;
    border-radius: 9px;
}
QPushButton#zoomResetBtn:hover {
    color: #4c9be8;
    background: rgba(76,155,232,0.12);
}
QPushButton#zoomResetBtn:pressed {
    background: rgba(76,155,232,0.25);
}

/* ══════════════════════════════════════════════════════════════
   Chat Bubbles — regole palette-relative (funzionano su tutti i temi).
   base.qss è caricato per ULTIMO, quindi questi override vincono sul tema.
   ══════════════════════════════════════════════════════════════ */

#chatBubbleRow {
    background: transparent;
    border: none;
}

QFrame#bubbleAI {
    background-color: palette(alternateBase);
    border: 1px solid rgba(128,128,128,0.22);
    border-radius: 14px;
    border-top-left-radius: 3px;
}

QFrame#bubbleUser {
    background-color: palette(alternateBase);
    border: 1px solid rgba(128,128,128,0.38);
    border-radius: 14px;
    border-top-right-radius: 3px;
}

#bubbleSenderAI {
    font-size: 11px;
    font-weight: 600;
    color: palette(highlight);
}

#bubbleSenderUser {
    font-size: 11px;
    font-weight: 600;
    color: palette(highlight);
}

QTextBrowser#bubbleText {
    background: transparent;
    border: none;
    color: palette(text);
    font-size: 13px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QPushButton#bubbleBtn {
    background-color: transparent;
    border: 1px solid rgba(128,128,128,0.22);
    border-radius: 5px;
    color: palette(mid);
    font-size: 11px;
    padding: 3px 10px;
    min-width: 0;
}

QPushButton#bubbleBtn:hover {
    background-color: rgba(128,128,128,0.12);
    border-color: palette(highlight);
    color: palette(text);
}

QPushButton#bubbleBtn:pressed {
    background-color: rgba(128,128,128,0.22);
}

/* Pulsante Run alto (rowspan 3) — angoli molto smussati */
QPushButton#actionBtn[bigBtn="true"] {
    border-radius: 14px;
}

/* Pulsanti header: hamburger ≡, messaggi 📋, impostazioni ⚙️ */
QPushButton#hamburgerBtn {
    background: transparent;
    border: 1px solid palette(mid);
    border-radius: 8px;
    font-size: 18px;
    padding: 2px 6px;
}
QPushButton#hamburgerBtn:hover   { background: palette(button); border-color: palette(highlight); }
QPushButton#hamburgerBtn:pressed { background: palette(dark); }

#chatScroll {
    border: none;
}

#chatContainer {
    background-color: transparent;
}

/* ── Splitter sidebar ↔ contenuto ── */
QSplitter#bodySplitter::handle {
    background: palette(mid);
    width: 4px;
}
QSplitter#bodySplitter::handle:hover {
    background: palette(highlight);
}

/* ── Wrapper trasparenti nella sidebar e nell'header ── */
QWidget#logWrap       { background: transparent; }
QWidget#chatBtnRow    { background: transparent; }
QWidget#chatSearchRow { background: transparent; }

/* ── Checkbox "Seleziona tutto" nella sidebar ── */
QCheckBox#selectAllChk {
    spacing: 0;
    background: transparent;
}
QCheckBox#selectAllChk::indicator {
    width: 15px;
    height: 15px;
    border: 1.5px solid palette(mid);
    border-radius: 2px;
    background: transparent;
}
QCheckBox#selectAllChk::indicator:hover {
    border-color: palette(highlight);
}
QCheckBox#selectAllChk::indicator:checked {
    background: palette(highlight);
    border-color: palette(highlight);
    image: none;
}
QCheckBox#selectAllChk::indicator:indeterminate {
    background: palette(mid);
    border-color: palette(mid);
}

/* ── emergencyBtn urgency: colore di sfondo in base alla RAM usata ── */
QPushButton#emergencyBtn[urgency="warn"]  { background: rgba(255,193,7,0.28);  }
QPushButton#emergencyBtn[urgency="high"]  { background: rgba(183,28,28,0.42);  }
